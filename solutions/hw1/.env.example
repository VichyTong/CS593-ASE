# Copy to .env and edit locally. Credentials must never be committed.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_MAX_OUTPUT_TOKENS=1800
LLM_TIMEOUT=120
# GPT-6 Luna uses none to keep focused paper-reading tasks fast and economical.
# Clear this or choose a supported value when using a different model.
LLM_REASONING_EFFORT=none
# For Ollama, use http://localhost:11434/v1, key=ollama, and an installed model.
DATA_DIR=data
HOST=127.0.0.1
PORT=8000
# Set both when exposing the app beyond localhost; use HTTPS via a reverse proxy.
APP_USERNAME=
APP_PASSWORD=

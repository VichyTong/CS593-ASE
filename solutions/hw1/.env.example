# Copy to .env. Never commit .env or put keys in frontend code.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_BUDGET_USD=5.00
LLM_MAX_OUTPUT_TOKENS=1200
# USD per million tokens. Input uses the conservative cache-write price.
# Update these if changing provider/model; prices below are for GPT-6 Luna Standard.
LLM_INPUT_PRICE=0.125
LLM_OUTPUT_PRICE=0.50
# For Ollama: http://localhost:11434/v1, key=ollama, model=your installed model
LLM_TIMEOUT=120
DATA_DIR=data
HOST=127.0.0.1
PORT=8000
# Optional HTTP Basic authentication for a deployment; set BOTH values.
APP_USERNAME=
APP_PASSWORD=
